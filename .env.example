# ---------------------------------------------------------------------------
# Sarai AI configuration. Copy to .env and edit. All values are read from the
# environment only -- there is no config file format.
# ---------------------------------------------------------------------------

# --- Storage ---------------------------------------------------------------
# Uploads, normalized wavs and generated documents live under here.
DATA_DIR=./data
# Reject uploads that would leave less than this much free disk (bytes). 5 GB.
MIN_FREE_DISK_BYTES=5368709120
# Hard upload cap (bytes). 500 MB.
UPLOAD_MAX_BYTES=524288000

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call the API. The Vite dev server proxies
# /api, so this only matters if you serve the frontend from another host.
CORS_ORIGINS=http://localhost:5173

# --- Worker ----------------------------------------------------------------
WORKER_POLL_SECONDS=2.0
# A job whose claim is older than this is considered abandoned and released.
WORKER_STALE_CLAIM_MINUTES=30
WORKER_MAX_ATTEMPTS=3
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# --- ASR -------------------------------------------------------------------
# typhoon-whisper-turbo: fast, ~6 GB VRAM. Good default.
# typhoon-whisper-large-v3: more accurate, slower, ~12 GB VRAM.
ASR_MODEL=typhoon-ai/typhoon-whisper-turbo
# auto | cuda | mps | cpu. auto picks cuda, then mps, then cpu.
ASR_DEVICE=auto

# --- Diarization -----------------------------------------------------------
# The diarization pipeline is gated. Accept the license for the model below AND
# for pyannote/segmentation-3.0, which it pulls in, using the same account that
# issued HF_TOKEN. With no token or an unaccepted gate, diarization is skipped
# and every segment gets SPEAKER_00.
#   https://huggingface.co/pyannote/speaker-diarization-community-1
#   https://huggingface.co/pyannote/segmentation-3.0
# Note: pyannote 4.x redirects the older name speaker-diarization-3.1 to
# community-1, so pinning the old name buys you nothing but a confusing 403.
HF_TOKEN=
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

# --- LLM summarization -----------------------------------------------------
# Set to false to disable third-party summarization entirely. Transcription
# still works; the summarize endpoint returns 503.
LLM_ENABLED=true
# deepseek | anthropic
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5

# Single-call threshold. Transcripts longer than this are map-reduced.
LLM_SINGLE_CALL_CHARS=40000
LLM_CHUNK_CHARS=30000
LLM_CHUNK_OVERLAP_SEGMENTS=2
LLM_TIMEOUT_SECONDS=300
